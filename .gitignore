# Virtual environments. .venv-linux is the WSL2 environment (ADR-017 A). On this
# machine it is a link to the Linux file system, which Windows sees as a file, so
# its pattern has no trailing slash.
.venv/
.venv-linux

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Compiled artifacts (the core builds out of source, ~/build/cfd-core)
*.so
*.dylib
*.o
*.pyd

# Simulation output
results/
*.npz

# Test reports (generated by CI, not committed)
# docs/reports/ is NOT ignored -- phase completion reports are committed
/reports/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.vscode/launch.json
.idea/
.claude/*
!.claude/commands/

# Temporary files
*.tmp
*.bak
*.swp

# Coverage
.coverage
htmlcov/

# Working prompts for agent sessions (local only)
docs/prompts/
