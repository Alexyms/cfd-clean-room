# Normalize line endings: LF in the repository, native in the working tree.
# This fixes phantom diffs on Windows clones regardless of core.autocrlf.
* text=auto

# Binary types. None are tracked today; these cover simulation output and
# figures that later phases may commit.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.npy binary
*.npz binary
*.so binary
*.dylib binary
*.dll binary
# The fetched data files are compared with their published checksums
# (tests/test_backward_step.py), so their bytes must not change on checkout.
validation/data/** -text
